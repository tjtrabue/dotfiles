! xmodmap is an Xorg utility for modifying keymaps and pointer button mappings.
! See the Arch Wiki for some fantastic documentation:
! https://wiki.archlinux.org/title/Xmodmap

! Remap "CapsLock" to "Ctrl", and make "Shift + CapsLock" = "CapsLock"
clear lock
clear control
add control = Caps_Lock Control_L Control_R
keycode 66 = Control_L Caps_Lock NoSymbol NoSymbol