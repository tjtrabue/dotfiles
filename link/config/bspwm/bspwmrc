#!/bin/sh

pgrep -x sxhkd >/dev/null || sxhkd &

# Set desktops on various connected displays
bspc monitor -d I II III IV
if xrandr -q | grep -E -q "DP-0\s*connected"; then
  bspc monitor DP-0 -d I V VI VII VII
fi
if xrandr -q | grep -E -q "DP-1\s*connected"; then
  bspc monitor DP-1 -d VIII IX X
fi

# Load multi-monitor configuration
defaultArandrProfileFile="${HOME}/.screenlayout/default.sh"
if [ -f "${defaultArandrProfileFile}" ]; then
  sh "${defaultArandrProfileFile}"
  bspc monitor eDP-1-1 -d "1" "2" "3" "4"
  bspc monitor DP-0 -d "5" "6" "7"
  bspc monitor DP-1 -d "8" "9" "10"
fi
unset defaultArandrProfileFile

bspc config border_width 2
bspc config window_gap 12

bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true

# Use mouse to move/resize floating windows.
# NOTE: You must hold down the super key to perform pointer actions.
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action2 resize_corner

### Auto-start applications ###

# Start the compositing manager in the background
picom --config "${HOME}/.config/picom/picom.conf" &

# Wallpaper
# Use feh commands in ~/.fehbg to set wallpaper
"${HOME}/.fehbg" &

# Notification
dunst &

# System Panel
polybarLauncher="${HOME}/.config/polybar/launch.sh"
if [ -f "${polybarLauncher}" ]; then
  # Launch Polybar from custom shell script
  /bin/sh "${polybarLauncher}"
else
  # Otherwise, fall back on default polybar. This is not very useful, but serves
  # as an indicator that something is wrong with our polybar configuration.
  polybar &
fi
unset polybarLauncher

# System Tray
if [ -n "$(command -v stalonetray)" ]; then
  stalonetray &
fi

# XScreenSaver
# Check the ~/.xscreensaver file for settings, and use the
# `xscreensaver-settings` command to configure the screensaver/locking behavior
# You can issue `xscreensaver-command -lock` to lock the X session manually.
if [ -n "$(command -v xscreensaver)" ]; then
  xscreensaver --no-splash &
fi

# XSS-Lock
# This command hooks a selected screen locker program into Systemd's 'suspend',
# 'hibernate', 'lock-session', and ''unlock-session' events. This allows
# automatically triggering xscreensaver's lock command when Systemd locks the
# user's session, or when the user manually locks their session with
# `loginctl lock-session`.
if [ -n "$(command -v xss-lock)" ] && [ -n "$(command -v xscreensaver)" ]; then
  xss-lock -- xscreensaver-command -lock &
fi

