#!/usr/bin/env bash

# Trap errors and print error message
trap 's=$?; echo "$0: Error on line "${LINENO}": ${BASH_COMMAND}"; exit $s' ERR

# Variables {{{
declare DOTFILES_HOME="${HOME}/.dotfiles"
declare THIS_EXEC="$(basename "${BASH_SOURCE[0]}")"

# Logging variables
declare LOG_TO_FILE=""
declare LOG_LEVEL=3
# }}}

# Imports {{{
. "${DOTFILES_HOME}/shell/common/source/common.sh" && src
# }}}

# Functions {{{
ipa__help() {
  command cat <<EOF
${THIS_EXEC}

<insert description here>

USAGE:
  ${THIS_EXEC} [OPTIONS]

OPTIONS:
  -h | --help
    Print the help message (this message) and exit.
EOF
}

# PulseAudio requires a system user named "pulse" in order to function.
ipa__create_pulse_user() {
  log_info "Creating pulse user"
  sudo useradd -r -G audio,input pulse
}

# PulseAudio should be enabled as service on a per-user basis.
# That's just how it works.
ipa__link_pulse_user_service_module() {
  log_info "Linking pulseaudio Systemd user service"
  systemctl --user enable --now pulseaudio
}

ipa__main() {
  ipa__create_pulse_user &&
  ipa__link_pulse_user_service_module
}
# }}}

# Parse CLI Options {{{
args=$(getopt -o h --long help -n 'init_<name_here>' -- "$@")
eval set -- "$args"

# extract options and their arguments into variables.
while true; do
  case "$1" in
  -h | --help)
    ipa__help
    exit 0
    ;;

  --)
    shift
    break
    ;;

  *)
    err "Unknown option $1 to ${THIS_EXEC}"
    exit 2
    ;;
  esac
done
# }}}

ipa__main "${@}"

