#!/usr/bin/env bash

# Trap errors and print error message
trap 's=$?; echo "$0: Error on line "${LINENO}": ${BASH_COMMAND}"; exit $s' ERR

# Variables {{{
declare DOTFILES_HOME="${HOME}/.dotfiles"
declare THIS_EXEC="$(basename "${BASH_SOURCE[0]}")"

# The Dropbox root directory on the local filesystem.
declare DROPBOX_HOME="${HOME}/Dropbox"

# Logging variables
declare LOG_TO_FILE=""
declare LOG_LEVEL=3
# }}}

# Imports {{{
. "${DOTFILES_HOME}/shell/common/source/common.sh" && src
# }}}

# Functions {{{
idb__help() {
  command cat <<EOF
${THIS_EXEC}

Initialize Dropbox in as automated a way as possible.

USAGE:
  ${THIS_EXEC} [OPTIONS]

OPTIONS:
  -h | --help
    Print the help message (this message) and exit.
EOF
}

idb__install_dropbox__arch_linux() {
  log_info "Initializing Dropbox for Arch Linux"

  if [ -x "$(command -v dropbox)" ]; then
    warn "Dropbox client already installed. Terminating."
    return 1
  fi

  # This package is an unnamed dependency for the dropbox client.
  sudo pacman -S --noconfirm python-gpgme
  # Use the AUR helper to install the dropbox client.
  aurhi dropbox
}

idb__configure_dropbox__arch_linux() {
  # Activate the Systemd module to get Dropbox to start up when the computer
  # boots up.
  sudo systemctl enable --now "dropbox@${USER}"

  # This hack is a workaround to keep the Dropbox client from automatically
  # updating. If the client updates itself, it breaks on Arch Linux.
  # What we're doing here is removing the Dropbox metadata directory, and
  # recreating it with read-only permissions.
  rm -rf "${HOME}/.dropbox-dist"
  install -dm0 "${HOME}/.dropbox-dist"
}

idb__configure_dropbox__linux() {
  local distro="$(getdistro)"

  log_info "Initializing Dropbox system service"
  case "${distro}" in
  "Arch Linux")
    idb__configure_dropbox__arch_linux
    ;;
  *)
    err "Unsupported Linux distro: ${MAGENTA}${distro}${NC}"
    return 1
    ;;
  esac
}

idb__install_dropbox__linux() {
  local distro="$(getdistro)"

  log_info "Installing Dropbox for a Linux distribution"
  case "${distro}" in
  "Arch Linux")
    idb__install_dropbox__arch_linux
    ;;
  *)
    err "Unsupported Linux distro: ${MAGENTA}${distro}${NC}"
    return 1
    ;;
  esac
}

# Keep certain large directories from syncing so as not to take up undue disk
# space on the local machine.
idb__exclude_directories_from_sync() {
  if [ -n "$(command -v dropbox-cli)" ]; then
    droppbox-cli exlude add \
      "${DROPBOX_HOME}/Computer Science/Courses/Clean Code" \
      "${DROPBOX_HOME}/test"
  else
    err 'Could not find dropbox-cli executable on $PATH'
    returh 1
  fi
}

idb__install_dropbox() {
  local osType="$(getostype)"

  case "${osType}" in
  "Linux")
    idb__install_dropbox__linux
    ;;
  *)
    err "Unsupported OS type: ${MAGENTA}${osType}${NC}"
    return 1
    ;;
  esac
}

# Autostart Dropbox at login and initialize the service.
idb__configure_dropbox() {
  local osType="$(getostype)"

  case "${osType}" in
  "Linux")
    idb__configure_dropbox__linux
    ;;
  *)
    err "Unsupported OS type: ${MAGENTA}${osType}${NC}"
    return 1
    ;;
  esac
}

idb__main() {
  print_header "Initializing Dropbox"
  idb__install_dropbox
  idb__configure_dropbox
  idb__exclude_directories_from_sync
}
# }}}

# Parse CLI Options {{{
args=$(getopt -o h --long help -n 'init_<name_here>' -- "$@")
eval set -- "$args"

# extract options and their arguments into variables.
while true; do
  case "$1" in
  -h | --help)
    idb__help
    exit 0
    ;;

  --)
    shift
    break
    ;;

  *)
    err "Unknown option $1 to ${THIS_EXEC}"
    exit 2
    ;;
  esac
done
# }}}

idb__main "${@}"

